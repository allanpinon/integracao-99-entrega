# --- Serviço ---
PORT=3000
BASE_URL=https://SEU-SERVICO.up.railway.app
DATA_DIR=/data
ADMIN_TOKEN=troque-por-um-token-longo

# --- Cardápio Web (app privado OAuth) ---
CW_ENV=sandbox                 # sandbox | production
CW_CLIENT_ID=
CW_DRIVER_NAME=99 Entrega      # nome exato do entregador cadastrado no CW
CW_POLL_INTERVAL_MS=30000

# --- 99 Entrega ---
N99_API_BASE=https://entrega.99app.com
N99_CLIENT_ID=
N99_CLIENT_SECRET=
N99_WEBHOOK_KEY=               # obrigatório em produção
N99_PACKAGE_WEIGHT=5kg         # 1kg | 5kg | 10kg | 20kg | 30kg
N99_NEED_PICKUP_CODE=false
N99_NEED_DROPOFF_CODE=false
N99_RETURN_TYPE=2              # 1 = devolver à loja | 2 = descartar
N99_RECONCILE_INTERVAL_MS=60000

# --- Coleta (cozinha Ipiranga) ---
PICKUP_STREET=Rua Bom Pastor
PICKUP_NUMBER=1899
PICKUP_COMPLEMENT=Vai Um Açaí
PICKUP_NEIGHBORHOOD=Ipiranga
PICKUP_CITY=São Paulo
PICKUP_STATE=SP
PICKUP_CEP=04203-052
PICKUP_NAME=Vai Um Açaí? - Açaí do Pará Artesanal
PICKUP_PHONE=11933393344
# PICKUP_LAT=
# PICKUP_LNG=

# --- Regras ---
ALLOW_UNPAID_OFFLINE=false     # true = também despacha pagamento na entrega não marcado como pago
